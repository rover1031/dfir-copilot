# --- Jupyter ---
JUPYTER_TOKEN=cambia-este-token

# --- Modelo de lenguaje (el proveedor se elige aquí, no en el código) ---
LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5        # opcional; este es el valor por defecto de Anthropic
ANTHROPIC_API_KEY=pega-aqui-tu-clave

# --- Alternativa: OpenAI (descomenta, y comenta las líneas de Anthropic) ---
# LLM_PROVIDER=openai
# LLM_MODEL=indica-el-modelo         # obligatorio con OpenAI
# OPENAI_API_KEY=pega-aqui-tu-clave

# --- Ajustes opcionales ---
# LLM_TEMPERATURE=                   # vacío = no se envía (claude-sonnet-5-5 no admite otros valores)
# LLM_MAX_TOKENS=8192                # alto a propósito: el razonamiento del modelo cuenta dentro del límite
# LLM_TIMEOUT_S=60
